---
import '../styles/variables.css';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ferdinando Balzarro — Scrittura, pratica, visione",
  description = "Sito ufficiale di Ferdinando Balzarro. Karate, scrittura, presenza, ricerca interiore. Bologna."
} = Astro.props;

// Структуровані дані JSON-LD для агента та пошукових систем
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Ferdinando Balzarro",
  "url": "https://ferdinandobalzarro.it/",
  "image": "https://ferdinandobalzarro.it/ferdinandobalzarro-hero.jpg",
  "sameAs": [
    "https://www.facebook.com/share/1DuhTeJWbM/"
  ],
  "jobTitle": "Scrittore e Maestro di Karate",
  "worksFor": {
    "@type": "Organization",
    "name": "Ferdinando Balzarro Portfolio"
  },
  "email": "balzarro.nando@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Bologna",
    "addressCountry": "IT"
  },
  "knowsAbout": [
    "Letteratura",
    "Karate",
    "Filosofia"
  ]
};
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://ferdinandobalzarro.it/" />
    
    <!-- Структуровані дані JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Оптимізоване завантаження шрифтів -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link 
      rel="preload" 
      as="style" 
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" 
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" />
    </noscript>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://ferdinandobalzarro.it/" />
    <meta name="google-site-verification" content="or6jrWjd1woAk5IfULu_cclkHHJ_78vt30kQmOYyWew" />
  </head>
  <body>
    <slot />
    <script defer src="https://web.staton.app/wm.js" data-site-key="site_0e11701895f0"></script>
  </body>
</html>
